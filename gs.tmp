    <script type="speculationrules">
        {
            "prerender": [
                {
                    "where": {
                        "and": [
                            { "href_matches": "/*" },
                            { "not": { "href_matches": "/logout" }}
                        ]
                    },
                    "eagerness": "moderate"
                },
                {
                    "where": {
                        "and": [
                            { "selector_matches": ".a-button" },
                            { "not": { "selector_matches": ".a-button--style-hollow" }},
                            { "not": { "href_matches": "/logout" }}
                        ]
                    }
                }
            ]
        }
    </script>
